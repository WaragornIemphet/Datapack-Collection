# ==================================================
#  THE STRATEGIST - MASTER DYNAMIC HUD
# ==================================================
# 1. MATH & DYNAMIC CONTEXT TAGS
# ==================================================
# Math
scoreboard players operation @s pullui = @s spacepull_cd
scoreboard players add @s pullui 19
scoreboard players operation @s pullui /= #const 20
scoreboard players operation @s swapui = @s spaceswap_cd
scoreboard players add @s swapui 19
scoreboard players operation @s swapui /= #const 20
scoreboard players operation @s fireui = @s sentryfire_cd
scoreboard players add @s fireui 19
scoreboard players operation @s fireui /= #const 20
scoreboard players operation @s placeui = @s sentryplace_cd
scoreboard players add @s placeui 19
scoreboard players operation @s placeui /= #const 20
scoreboard players operation @s t_configui = @s trapconfig_cd
scoreboard players add @s t_configui 19
scoreboard players operation @s t_configui /= #const 20
scoreboard players operation @s t_placeui = @s trapplace_cd
scoreboard players add @s t_placeui 19
scoreboard players operation @s t_placeui /= #const 20

# Context Tags (Space/Sentry Targets - Now respects the 64 block limit!)
tag @s remove ui_hastgt
execute at @s if entity @e[tag=spacetarget,distance=..64] run tag @s add ui_hastgt

# Context Tags (Trap RMB Actions)
tag @s remove ui_t_config
tag @s remove ui_t_trick
tag @s remove ui_t_dodge
execute at @s if entity @e[type=armor_stand,tag=trapsentry,distance=..3] run tag @s add ui_t_config
execute at @s unless entity @s[tag=ui_t_config] if entity @e[type=armor_stand,tag=trapsentry,distance=..64] run tag @s add ui_t_trick
execute at @s unless entity @s[tag=ui_t_config] unless entity @s[tag=ui_t_trick] run tag @s add ui_t_dodge

